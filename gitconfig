[credential "https://github.com"]
	helper = !gh auth git-credential
[user]
	name = akiq
	email = yuqiujp@gmail.com
[core]
	editor = emacsclient --tty
[pull]
	rebase = true
[diff]
	algorithm = histogram
	colorMoved = default
[merge]
	conflictstyle = diff3
[rerere]
	enabled = true
[init]
	defaultBranch = main
# Machine-local settings (e.g. [maintenance] repo list) live untracked in
# ~/.gitconfig.local, seeded by install.sh.
[include]
	path = ~/.gitconfig.local
