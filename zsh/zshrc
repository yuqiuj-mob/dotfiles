# C-M-u: up-directory
up-directory() {
    builtin cd .. || return
    # p10k builds its prompt in precmd; re-run the hooks so the cwd segment
    # refreshes, otherwise reset-prompt just redraws the stale cached prompt.
    local precmd
    for precmd in "${precmd_functions[@]}"; do
        "$precmd" &>/dev/null
    done
    zle reset-prompt
}
zle -N up-directory
bindkey '\eu' up-directory      # Alt-u → cd .. (reliable; mnemonic "up")
bindkey '\e\C-u' up-directory   # Ctrl-Alt-u fallback (may not reach terminal)

# Alt-l: list cwd with `exa -l --icons`. push-line stashes whatever you've
# already typed and restores it on the next prompt, so it's safe mid-command.
exa-l() {
    zle push-line
    BUFFER='exa -l --icons'
    zle accept-line
}
zle -N exa-l
bindkey '\el' exa-l             # Alt-l → exa -l --icons

