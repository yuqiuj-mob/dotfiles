# Quick add to pubs DB; extracts DOI from PDF text, falls back to second arg.
pubadd() {
  local pdf="$1" doi="$2"
  if [[ -z "$doi" ]]; then
    doi=$(pdftotext "$pdf" - 2>/dev/null | grep -oE '10\.[0-9]{4,}/[A-Za-z0-9._/+-]+' | head -1)
  fi
  if [[ -z "$doi" ]]; then
    echo "No DOI in $pdf — pass it as second arg: pubadd <pdf> <doi>" >&2
    return 1
  fi
  pubs add -D "$doi" -L -d "$pdf"
}

