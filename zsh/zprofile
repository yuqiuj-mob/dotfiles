
# Homebrew (macOS): puts /opt/homebrew/bin (Apple Silicon) or /usr/local/bin
# (Intel) on PATH; guarded so this file stays portable to Linux machines.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# OrbStack (macOS): command-line tools and integration
[[ -r ~/.orbstack/shell/init.zsh ]] && source ~/.orbstack/shell/init.zsh

# >>> coursier install directory >>>
export PATH="$PATH:$HOME/.local/share/coursier/bin"
# <<< coursier install directory <<<
